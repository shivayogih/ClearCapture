    <string name="cc_loading">Loading…</string>
    <string name="cc_character_count">%1$d / %2$d</string>
    <string name="cc_character_count_description">%1$d of %2$d characters</string>

    <!-- Permission card. -->
    <string name="cc_permission_allow">Allow</string>
    <string name="cc_permission_granted">Allowed</string>
    <string name="cc_permission_denied">Not allowed yet</string>
    <string name="cc_permission_permanently_denied">Turned off. You can allow it in Settings</string>
