    <string name="cc_location_no_permission">No location permission</string>
    <plurals name="cc_location_ready_description">
        <item quantity="one">Location ready, accurate to %1$d metre</item>
        <item quantity="other">Location ready, accurate to %1$d metres</item>
    </plurals>
    <plurals name="cc_location_weak_description">
        <item quantity="one">Location weak, accurate to %1$d metre</item>
        <item quantity="other">Location weak, accurate to %1$d metres</item>
    </plurals>
    <string name="cc_open_settings">Open settings</string>

