<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera for preview and capture. Location is declared by the location module. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Optional, so adding the SDK never hides the host app from devices on Google Play. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <activity
            android:name="com.clearcapture.clearcapture.api.internal.CaptureActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="false"
            android:theme="@style/CcTheme.Capture" />

        <provider
            android:name="com.clearcapture.clearcapture.api.internal.files.ClearCaptureFileProvider"
            android:authorities="${applicationId}.clearcapture.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cc_file_paths" />
        </provider>
    </application>
</manifest>
